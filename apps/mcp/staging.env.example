# Use the API and public MCP URLs from the same staging deployment.
T3X_API_URL=https://api.example.com/api
T3X_MCP_PUBLIC_URL=https://mcp.example.com/mcp

# Agent operates on the Draft. A human prepares the Review and commits in Web.
T3X_MCP_CAPABILITIES=read-only,workspace,workspace:write,transitions

# For delegated OAuth access, configure these on both the API and MCP services.
# T3X_MCP_RESOURCE_URL=https://mcp.example.com/mcp
# T3X_MCP_OAUTH_ISSUER=https://t3x.example.com
# Supply T3X_MCP_OAUTH_SECRET through the secret manager (32 random bytes, base64url).
# On the API, supply the real host registration:
# T3X_MCP_OAUTH_CLIENTS=[{"client_id":"editorial-agent","client_name":"Editorial Agent","redirect_uris":["https://agent.example.com/oauth/callback"]}]
# Remove the explicit capability list above to enable the managed repository profile.
