{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "env": ["NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_AUTH_DISABLED"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "env": ["DATABASE_URL", "T3X_TEST_PG_PORT", "T3X_TEST_PG_DATA_DIR"],
      "cache": true
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": ["AUTH_DISABLED", "NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_AUTH_DISABLED"],
      "passThroughEnv": [
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "https_proxy",
        "http_proxy",
        "ALL_PROXY",
        "all_proxy",
        "NO_PROXY",
        "no_proxy",
        "OPENAI_BASE_URL",
        "ANTHROPIC_BASE_URL"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
