# ================================
# T3X Configuration
# ================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# ================================
# LLM Provider Keys
# ================================
# At least one provider key is required for semantic extraction and chat.
# Set in shell (recommended) or here:
#   export ANTHROPIC_API_KEY=sk-ant-...

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_STUDIO_KEY=

# Required before storing provider keys or deploy-agent tokens in the database.
# Generate with: openssl rand -base64 32
T3X_CREDENTIAL_ENCRYPTION_KEY=
# Optional comma-separated previous keys used only while records rotate lazily.
T3X_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=

# ================================
# First-Run Auth Behavior
# ================================
# Source development (`pnpm dev:api`, `pnpm dev:webui`) defaults AUTH_DISABLED=true
# when your shell does not already define it, so http://localhost:3000 opens
# directly into the app.
#
# To exercise the login flow during source development, export
# AUTH_DISABLED=false in the same shell before starting both dev processes.
# The source-dev launcher sets the default before the apps read `.env`.
#
# Docker and other self-hosted deployments keep auth on by default through
# docker-compose.yml and use the built-in username/password login at /login.
# Leave AUTH_DISABLED unset for the normal first-run experience.

AUTH_DISABLED=

# Comma-separated authenticated human user IDs or human API-key IDs allowed to
# administer global providers and mutate global templates. Leave empty to fail closed.
T3X_OPERATOR_USER_IDS=
T3X_OPERATOR_KEY_IDS=

# Dangerous explicit override required when binding the unauthenticated standalone
# Runner to a non-loopback interface. Prefer leaving Runner on loopback.
T3X_ALLOW_UNAUTHENTICATED_RUNNER_NETWORK=

# ================================
# Dangerous Development Tools
# ================================
# Enables the raw SQL inspector at /dev/db in the WebUI.
# This is ignored unless NODE_ENV=development. Leave unset unless you are
# deliberately inspecting a local database.

T3X_ENABLE_DEV_SQL=

# ================================
# Runner Private Agent Endpoints
# ================================
# Runner blocks loopback, private, link-local, and reserved agent targets by
# default. List only exact private origins that this deployment is expected to
# evaluate (comma-separated; paths are ignored). Public HTTP(S) agents do not
# need to be listed.
# Example: http://127.0.0.1:9000,http://agent-demo:9000

RUNNER_ENDPOINT_ALLOWLIST=

# Standalone source use binds to loopback by default. Container deployments may
# explicitly use 0.0.0.0 while keeping any published host port loopback-only.

RUNNER_HOST=

# Shared machine credential used only on API <-> Runner control routes. Use a
# random value (for example, openssl rand -hex 32). n8n receives per-run signed
# callback URLs and never receives this shared secret.
RUNNER_SERVICE_TOKEN=
