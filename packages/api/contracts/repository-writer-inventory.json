  "legacy_caller_guards": [
    {
      "symbol": "postExtractYops(",
      "roots": ["apps/web/src"],
      "allowed_files": [
        "apps/web/src/commands/yops/llmAdapter.ts",
        "apps/web/src/infrastructure/llm.ts"
      ]
    },
    {
      "symbol": "api.extractIncremental(",
      "roots": ["apps/web/src"],
      "allowed_files": ["apps/web/src/hooks/canvas/usePendingCommitExtraction.ts"]
    },
    {
      "symbol": "api.commitWorkbenchDraft(",
      "roots": ["apps/web/src"],
      "allowed_files": ["apps/web/src/hooks/canvas/usePendingCommitState.ts"]
    },
    {
      "symbol": "client.extract(",
      "roots": ["apps/cli/src", "packages/mcp/src"],
      "allowed_files": [
        "apps/cli/src/commands/extract.ts",
        "packages/mcp/src/tools/core/extract.ts"
      ]
    },
    {
      "symbol": "client.applyYOps(",
      "roots": ["apps/cli/src", "packages/mcp/src"],
      "allowed_files": ["apps/cli/src/commands/yops.ts", "packages/mcp/src/tools/core/edit.ts"]
    },
    {
      "symbol": "client.commitFromDraft(",
      "roots": ["apps/cli/src", "packages/mcp/src"],
      "allowed_files": ["apps/cli/src/commands/commit.ts", "packages/mcp/src/tools/core/commit.ts"]
